# Copy to .env (never commit it). All secrets stay on the server.
NETWORK=devnet                       # devnet | mainnet
HELIUS_KEY=                          # free key at helius.dev; used for RPC + roll-call history
# RPC_URL=                           # optional override
AI_API_KEY=                          # Anthropic API key for POST /generate
MASTER_KEY=                          # 64 hex chars: openssl rand -hex 32  (encrypts coin wallet keys)
OPERATOR_WALLET_KEY=                 # base58 secret key of the wallet that pays launch rent
POW_SECRET=                          # openssl rand -hex 32
SITE_BASE_URL=https://YOU.github.io/REPO   # where meta/<mint>.json and data/log.json are served
GITHUB_TOKEN=                        # fine-grained token, Contents: read+write on the Pages repo only
GITHUB_REPO=YOU/REPO
GITHUB_BRANCH=gh-pages
CORS_ORIGIN=https://YOU.github.io
MAX_LAUNCHES_PER_DAY=50
KILL_SWITCH=false
TOTAL_FEE_BPS=100
